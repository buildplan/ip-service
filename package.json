{
  "name": "ip-service",
  "version": "1.2.0",
  "main": "server.js",
  "dependencies": {
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "ip2location-nodejs": "^9.7.0",
    "ip2proxy-nodejs": "^4.4.0",
    "lru-cache": "^11.2.6",
    "maxmind": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.0",
    "terser": "^5.46.0"
  },
  "scripts": {
    "start": "node server.js",
    "build:js": "terser views/app.js -c -m -o views/app.min.js",
    "build:css": "npx @tailwindcss/cli -i ./views/input.css -o ./public/style.min.css --minify",
    "build": "npm run build:js && npm run build:css"
