{
  "name": "ip-service",
  "version": "1.2.0",
  "main": "server.js",
  "dependencies": {
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "ip2location-nodejs": "^9.8.0",
    "ip2proxy-nodejs": "^4.5.0",
    "lru-cache": "^11.5.3",
    "maxmind": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "maplibre-gl": "^6.20.0",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.4"
  },
  "scripts": {
    "start": "node server.js",
    "prestart": "node scripts/build-map.mjs --if-available",
    "build:js": "terser views/app.js -c -m -o views/app.min.js",
    "build:css": "npx @tailwindcss/cli -i ./views/input.css -o ./public/style.min.css --minify",
    "build:map": "node scripts/build-map.mjs",
    "build": "npm run build:map && npm run build:js && npm run build:css"
  }
}
