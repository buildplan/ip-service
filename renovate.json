{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "registryAliases": {
    "dhi.io": "dhi.io"
  },
  "hostRules": [
    {
      "matchHost": "dhi.io",
      "hostType": "docker",
      "username": "{{ secrets.MEND_DOCKERHUB_USERNAME }}",
      "password": "{{ secrets.MEND_DOCKERHUB_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Group all non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "All non-major dependencies",
      "automerge": true
    },
    {
      "description": "Trigger build on custom manager updates",
      "matchManagers": [
        "custom.regex"
      ],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "description": "Update Leaflet version in index.html",
      "customType": "regex",
      "managerFilePatterns": [
        "/^index\\.html$/"
      ],
      "matchStrings": [
        "renovate: leaflet-version=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "leaflet",
      "datasourceTemplate": "npm"
    },
    {
      "description": "Update Inter font version in input.css",
      "customType": "regex",
      "managerFilePatterns": [
        "/^views/input\\.css$/"
      ],
      "matchStrings": [
        "renovate: inter-version=(?<currentValue>[^\\s\\*]+)"
      ],
      "depNameTemplate": "rsms/inter",
      "datasourceTemplate": "github-tags"
    }
  ]
}
